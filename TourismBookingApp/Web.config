<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <connectionStrings>
    <!-- Update Data Source to your SQL Server instance name (e.g. (localdb)\MSSQLLocalDB) -->
    <add name="TourismDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=TourismBookingDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- Sets the default currency/number formatting site-wide to South African Rand (R)
         so every {0:C} bound field (Price, Total, Revenue) renders consistently,
         without needing to pass a CultureInfo manually on each page. -->
    <globalization culture="en-ZA" uiCulture="en-ZA" />
    <!-- Page access is controlled by Session["Role"] via DataAccess/AuthHelper.cs
         in each page's Page_Load, not by ASP.NET Forms Authentication â€”
         Login.aspx.cs never issues a Forms Auth cookie, so a <deny users="?" />
         rule here would redirect every page back to Login.aspx even after a
         successful sign-in. -->
  </system.web>
</configuration>
